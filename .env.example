# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Required in any non-development environment.
# Must be at least 32 bytes: it signs JWTs with HMAC-SHA256, and a shorter key
# weakens them. Generate a real one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-placeholder-replace-me-with-a-real-50-char-secret-key

# Never true outside local development.
DEBUG=True

# Comma-separated. Must be set once DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to the local sqlite file when unset.
# Postgres example: postgres://user:password@localhost:5432/trackflow
# DATABASE_URL=sqlite:///db.sqlite3

# JWT token lifetimes.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
